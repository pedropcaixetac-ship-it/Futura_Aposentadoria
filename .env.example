DATABASE_URL="postgresql://usuario:senha@localhost:5432/prontuario"

# Assinatura digital ICP-Brasil (certificado em nuvem). Cada provedor entrega
# client_id e client_secret quando a clínica se cadastra como sistema parceiro.
# VIDAAS_CLIENT_ID=""
# VIDAAS_CLIENT_SECRET=""
# BIRDID_CLIENT_ID=""
# BIRDID_CLIENT_SECRET=""
# Chave para cifrar a autorização dos profissionais (qualquer texto longo e secreto).
# ASSINATURA_CHAVE=""
# Mostra o "certificado de teste" mesmo em produção (não use com clientes reais).
# ASSINATURA_TESTE="1"

# Chave da Daily (daily.co) para o vídeo da teleconsulta.
DAILY_API_KEY=""

# Primeiro acesso ao Painel do dono do sistema (/painel), criado na primeira publicação.
# Sem estas variáveis, o acesso de demonstração é dono@futura.com / senha123.
# PAINEL_NOME="Pedro"
# PAINEL_EMAIL=""
# PAINEL_SENHA=""
