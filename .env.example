DATABASE_URL="postgresql://usuario:senha@localhost:5432/prontuario"

# Assinatura digital ICP-Brasil (certificado em nuvem). Cada provedor entrega
# client_id e client_secret quando a clínica se cadastra como sistema parceiro.
# VIDAAS_CLIENT_ID=""
# VIDAAS_CLIENT_SECRET=""
# BIRDID_CLIENT_ID=""
# BIRDID_CLIENT_SECRET=""
