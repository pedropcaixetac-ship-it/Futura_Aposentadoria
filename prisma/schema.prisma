// Modelo de dados do sistema.
// Toda informação de uma clínica carrega clinicId, para que uma clínica
// nunca enxergue dados de outra (o sistema será vendido para várias clínicas).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFISSIONAL
  RECEPCAO
}

enum EncounterStatus {
  RASCUNHO
  FINALIZADO
}

enum DocumentType {
  RECEITA
  ATESTADO
  PEDIDO_EXAME
  RELATORIO
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  patients  Patient[]
  templates RecordTemplate[]
  encounters Encounter[]
  auditLogs AuditLog[]
  documents ClinicalDocument[]
}

model User {
  id            String   @id @default(cuid())
  clinicId      String
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  name          String
  email         String
  passwordHash  String
  role          Role
  // Registro no conselho profissional (CRM, CRP, CRN, CRO...), exigido no prontuário.
  councilType   String?
  councilNumber String?
  councilUf     String?
  specialty     String?
  // Setor onde a pessoa trabalha (ex.: Recepção, Consultório 2), mostrado na barra lateral.
  sector        String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  sessions   Session[]
  encounters Encounter[]
  addenda    Addendum[]
  auditLogs  AuditLog[]
  snippets   TextSnippet[]
  documents  ClinicalDocument[]

  @@unique([clinicId, email])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Patient {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  // false quando veio do cadastro rápido da recepção e ainda falta completar.
  registrationComplete Boolean @default(true)

  // Identificação
  name          String
  socialName    String?
  birthDate     DateTime?
  sex           String?
  cpf           String?
  rg            String?
  cns           String?
  motherName    String?
  maritalStatus String?
  occupation    String?
  photo         String? // imagem pequena (data URL), reduzida no navegador

  // Contato (telefones guardados só com os números)
  phone                 String?
  phoneWhatsapp         Boolean @default(true)
  landline              String?
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Endereço
  cep        String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?

  // Convênio ("Particular" quando não há convênio)
  insurance           String?
  insuranceNumber     String?
  insuranceValidUntil DateTime?

  // Responsável legal
  guardianName         String?
  guardianCpf          String?
  guardianRelationship String?
  guardianPhone        String?

  // Outros
  referralSource String?
  notes          String?
  lgpdConsentAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Resumo clínico, sempre visível no topo do prontuário.
  allergies          String?
  currentMedications String?
  personalHistory    String?
  familyHistory      String?

  encounters Encounter[]
  documents  ClinicalDocument[]

  @@index([clinicId, name])
  @@unique([clinicId, cpf])
  @@unique([clinicId, cns])
}

// Modelo de atendimento (ex.: "Consulta clínica geral", "Psicologia - sessão").
// fields é uma lista de campos: [{ key, label, type: "text" | "textarea" }]
model RecordTemplate {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  specialty String?
  fields    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  encounters Encounter[]
}

// Um atendimento no prontuário. Enquanto RASCUNHO pode ser editado;
// depois de FINALIZADO fica imutável e só aceita adendos.
model Encounter {
  id             String          @id @default(cuid())
  clinicId       String
  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  professionalId String
  professional   User            @relation(fields: [professionalId], references: [id])
  templateId     String?
  template       RecordTemplate? @relation(fields: [templateId], references: [id])
  // Cópia dos campos do modelo no momento do atendimento, para que mudar o
  // modelo depois não altere atendimentos antigos.
  fields         Json
  content        Json            @default("{}")
  diagnoses      Json            @default("[]")
  status         EncounterStatus @default(RASCUNHO)
  startedAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  finalizedAt    DateTime?
  // Impressão digital (SHA-256) do conteúdo finalizado, para detectar adulteração.
  contentHash    String?

  addenda   Addendum[]
  documents ClinicalDocument[]

  @@index([clinicId, patientId, startedAt])
}

// Receita, atestado, pedido de exame ou relatório emitido num atendimento.
// Depois de emitido não pode ser alterado nem apagado (o banco bloqueia).
// É este texto que vira PDF e, mais à frente, recebe a assinatura ICP-Brasil.
model ClinicalDocument {
  id          String       @id @default(cuid())
  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  encounterId String
  encounter   Encounter    @relation(fields: [encounterId], references: [id])
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id])
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  type        DocumentType
  body        String
  createdAt   DateTime     @default(now())
  // Impressão digital (SHA-256) do texto emitido, como nos atendimentos.
  contentHash String

  @@index([encounterId])
}

model Addendum {
  id          String    @id @default(cuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  text        String
  createdAt   DateTime  @default(now())
}

// Trilha de auditoria (LGPD): quem viu ou alterou o quê, e quando.
model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  patientId String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([clinicId, patientId])
}

// Texto pronto de cada profissional ("usar modelo" ao lado de cada campo).
// fieldKey vazio: o texto aparece em todos os campos.
model TextSnippet {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  fieldKey  String?
  title     String
  text      String
  createdAt DateTime @default(now())

  @@index([ownerId, fieldKey])
}

model Cid10 {
  code        String @id
  description String

  @@index([description])
}
