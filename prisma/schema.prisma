// Modelo de dados do sistema.
// Toda informação de uma clínica carrega clinicId, para que uma clínica
// nunca enxergue dados de outra (o sistema será vendido para várias clínicas).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentType {
  CONSULTA
  RETORNO
  PROCEDIMENTO
  TELECONSULTA
}

enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  CHEGOU
  EM_ATENDIMENTO
  ATENDIDO
  FALTOU
  DESMARCADO
}

enum Role {
  ADMIN
  // Profissional de saúde com acesso completo ao prontuário (médico, enfermeiro, psicólogo...).
  PROFISSIONAL
  // Profissional de saúde com acesso restrito (técnico e auxiliar de enfermagem...): vê alergias,
  // medicamentos e os próprios atendimentos, mas não abre as consultas anteriores de outros profissionais.
  TECNICO
  RECEPCAO
  // Auxiliar administrativo: cuida da contabilidade e da parte trabalhista.
  ADMINISTRATIVO
}

// Tipo de vínculo de trabalho de um servidor.
enum EmploymentType {
  CLT
  PJ
  ESTAGIO
  AUTONOMO
}

enum EncounterStatus {
  RASCUNHO
  FINALIZADO
}

// Situação de uma cobrança ou despesa no financeiro.
enum FinanceStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  BOLETO
  CONVENIO
}

// Quem emite a nota fiscal de serviço (NFS-e) da consulta particular: a clínica, pelo CNPJ,
// ou o próprio profissional, como autônomo pelo CPF.
enum InvoiceIssuer {
  CLINICA
  PROFISSIONAL
}

// Andamento da nota pedida pelo paciente.
enum ServiceInvoiceStatus {
  PEDIDA
  EMITIDA
  CANCELADA
}

enum DocumentType {
  RECEITA
  ATESTADO
  PEDIDO_EXAME
  RELATORIO
  // Laudos do SUS, preenchidos sobre o formulário oficial.
  APAC
  AIH
  LME
}

// Tipo de instituição: a mesma base serve clínicas e hospitais. No hospital, a gestão
// da clínica (financeiro, contabilidade) fica de fora e entram os setores hospitalares.
enum InstitutionKind {
  CLINICA
  HOSPITAL
}

model Clinic {
  id                    String          @id @default(cuid())
  name                  String
  slug                  String          @unique
  kind                  InstitutionKind @default(CLINICA)
  createdAt             DateTime        @default(now())
  // Dados que aparecem no recibo.
  cnpj                  String?
  address               String?
  phone                 String?
  // Último número de recibo emitido (os recibos seguem uma sequência por clínica).
  lastReceiptNumber     Int             @default(0)
  // Contabilidade: regime de impostos e contato do escritório de contabilidade.
  taxRegime             String?
  accountantName        String?
  accountantEmail       String?
  accountantPhone       String?
  // Nota fiscal de serviço (NFS-e): quem emite e os dados fiscais da clínica.
  invoiceIssuer         InvoiceIssuer   @default(PROFISSIONAL)
  municipalRegistration String?
  // Código IBGE da cidade onde o serviço é prestado (Goiânia: 5208707).
  cityIbgeCode          String?
  // Código do serviço na lista nacional (Medicina: 04.01.01) e alíquota do ISS em centésimos de % (2% = 200).
  serviceCode           String?
  issRateBasisPoints    Int?
  // Último número de DPS (pedido de nota) enviado pela clínica na emissão automática.
  lastDpsNumber         Int             @default(0)
  // CNES: registro do estabelecimento no Ministério da Saúde, exigido nas guias dos convênios.
  cnes                  String?
  // Último número de guia de convênio emitido (as guias seguem uma sequência por clínica).
  lastClaimNumber       Int             @default(0)
  // Último número de lote de guias enviado aos convênios.
  lastBatchNumber       Int             @default(0)
  // Controle da empresa dona do sistema (Painel do dono). Clínica suspensa não consegue entrar.
  active                Boolean         @default(true)
  suspendedAt           DateTime?
  suspendedReason       String?
  // Responsável pela clínica no contrato com a empresa (contato do suporte e da cobrança).
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  // Plano contratado (módulos liberados) e último dia coberto pela mensalidade paga.
  // Sem plano, tudo fica liberado; sem data, a mensalidade não é controlada.
  planId                String?
  plan                  Plan?           @relation(fields: [planId], references: [id])
  paidUntil             DateTime?       @db.Date

  users             User[]
  patients          Patient[]
  templates         RecordTemplate[]
  encounters        Encounter[]
  auditLogs         AuditLog[]
  priceItems        PriceItem[]
  charges           Charge[]
  expenses          Expense[]
  purchases         Purchase[]
  documents         ClinicalDocument[]
  workHours         WorkHours[]
  scheduleBlocks    ScheduleBlock[]
  appointments      Appointment[]
  signedPdfs        SignedPdf[]
  contracts         EmploymentContract[]
  vacations         Vacation[]
  payrollEntries    PayrollEntry[]
  obligations       TaxObligation[]
  obligationDone    ObligationEntry[]
  teleconsultations Teleconsultation[]
  whatsappMessages  WhatsappMessage[]
  healthPlans       HealthPlan[]
  claims            InsuranceClaim[]
  claimBatches      ClaimBatch[]
  claimItems        ClaimItem[]
  claimAppeals      ClaimAppeal[]
  problems          ProblemReport[]
  serviceInvoices   ServiceInvoice[]
  platformPayments  ClinicPayment[]
  platformNotices   PlatformNotice[]
  wards             Ward[]
  beds              Bed[]
  admissions        Admission[]
  bedMovements      BedMovement[]
  visits            Visit[]
  vitalRecords      VitalRecord[]
  fluidEntries      FluidEntry[]
  emergencyVisits   EmergencyVisit[]
  prescriptionItems PrescriptionItem[]
  medicationChecks  MedicationCheck[]
  pharmacyProducts  PharmacyProduct[]
  stockMovements    StockMovement[]
  mealDeliveries    MealDelivery[]
  isolations        IsolationPrecaution[]
  infections        HospitalInfection[]
  chemoProtocols    ChemoProtocol[]
  chemoPlans        ChemoPlan[]
  chemoSessions     ChemoSession[]
  operatingRooms    OperatingRoom[]
  surgeries         Surgery[]
  surgeryChecks     SurgeryChecklist[]
  cmeKits           CmeKit[]
  sterilizations    SterilizationLoad[]
  sterilePackages   SterilePackage[]
  examTypes         ExamType[]
  supplyItems       SupplyItem[]
  supplyMovements   SupplyMovement[]
  supplyRequests    SupplyRequest[]
  supplyLines       SupplyRequestLine[]
  equipments        Equipment[]
  workOrders        WorkOrder[]
  examRequests      ExamRequest[]
  hospitalPrices    HospitalPrice[]
  hospitalBills     HospitalBill[]
  consultRequests   ConsultRequest[]
  attendingChanges  AttendingChange[]
  hospitalBillItems HospitalBillItem[]
}

model User {
  id                    String    @id @default(cuid())
  clinicId              String
  clinic                Clinic    @relation(fields: [clinicId], references: [id])
  name                  String
  // Vazio para quem não usa o sistema (ex.: equipe de limpeza).
  email                 String?
  // CPF só com números. Serve para entrar no sistema no lugar do e-mail.
  cpf                   String?
  // Identificação e contato do servidor, nos mesmos moldes do cadastro de paciente.
  socialName            String?
  birthDate             DateTime? @db.Date
  sex                   String?
  rg                    String?
  cns                   String?
  motherName            String?
  maritalStatus         String?
  photo                 String? // imagem pequena (data URL), reduzida no navegador
  phone                 String?
  landline              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  cep                   String?
  street                String?
  number                String?
  complement            String?
  district              String?
  city                  String?
  state                 String?
  passwordHash          String
  // Senha criada ou trocada pelo gerente: a pessoa cria a própria no próximo acesso.
  mustChangePassword    Boolean   @default(false)
  // Verificação em duas etapas (Google Authenticator e similares). O segredo fica cifrado;
  // dos códigos de recuperação, só a impressão digital. totpLastStep impede usar o mesmo código duas vezes.
  totpSecret            String?
  totpEnabledAt         DateTime?
  totpLastStep          Int?
  totpRecoveryCodes     String[]  @default([])
  role                  Role
  // Registro no conselho profissional (CRM, CRP, CRN, CRO...), exigido no prontuário.
  councilType           String?
  councilNumber         String?
  councilUf             String?
  // RQE: Registro de Qualificação de Especialista do médico (CRM). Pode ter mais de um, separados por vírgula.
  rqe                   String?
  specialty             String?
  // Setor onde a pessoa trabalha (ex.: Recepção, Consultório 2), mostrado na barra lateral.
  sector                String?
  // Inscrição municipal do profissional que emite a própria nota como autônomo.
  municipalRegistration String?
  // Último número de DPS enviado pelo profissional que emite a própria nota (cada emissor tem a sua sequência).
  lastDpsNumber         Int       @default(0)
  // Porcentagem do valor recebido que fica com o profissional (repasse).
  commissionPercent     Int?
  // Função ou cargo mostrado no cadastro de servidores (ex.: Médica, Recepcionista).
  jobTitle              String?
  // Abas liberadas para a pessoa. Enquanto customTabs for false, valem as abas
  // padrão do perfil (ver src/lib/tabs.ts).
  customTabs            Boolean   @default(false)
  allowedTabs           String[]  @default([])
  // false para quem só está no cadastro da equipe e não entra no sistema.
  systemAccess          Boolean   @default(true)
  // false bloqueia o login. No desligamento a pessoa perde o acesso, mas continua
  // no cadastro, porque é a autora de atendimentos antigos do prontuário.
  active                Boolean   @default(true)
  terminatedAt          DateTime? @db.Date
  terminationReason     String?
  createdAt             DateTime  @default(now())

  sessions             Session[]
  encounters           Encounter[]
  addenda              Addendum[]
  auditLogs            AuditLog[]
  snippets             TextSnippet[]
  templates            RecordTemplate[]
  charges              Charge[]
  documents            ClinicalDocument[]
  workHours            WorkHours[]
  scheduleBlocks       ScheduleBlock[]
  appointments         Appointment[]         @relation("AppointmentProfessional")
  appointmentsCreated  Appointment[]         @relation("AppointmentCreator")
  signatureSessions    SignatureSession[]
  teleconsultations    Teleconsultation[]
  signedPdfs           SignedPdf[]
  // Dados de contrato de trabalho (aba Contabilidade). Vazio para quem não é funcionário da clínica.
  contract             EmploymentContract?
  whatsappMessages     WhatsappMessage[]
  claims               InsuranceClaim[]
  problems             ProblemReport[]
  noticeDismissals     NoticeDismissal[]
  admissionsAttending  Admission[]           @relation("AdmissionAttending")
  admissionsCreated    Admission[]           @relation("AdmissionCreator")
  admissionsDischarged Admission[]           @relation("AdmissionDischarger")
  bedMovements         BedMovement[]
  visitsRegistered     Visit[]
  vitalRecords         VitalRecord[]         @relation("VitalRecorder")
  vitalRecordsCanceled VitalRecord[]         @relation("VitalCanceler")
  fluidEntries         FluidEntry[]          @relation("FluidRecorder")
  fluidEntriesCanceled FluidEntry[]          @relation("FluidCanceler")
  emergencyRegistered  EmergencyVisit[]      @relation("EmergencyRegistrar")
  emergencyTriaged     EmergencyVisit[]      @relation("EmergencyTriager")
  emergencyAttended    EmergencyVisit[]      @relation("EmergencyDoctor")
  emergencyClosed      EmergencyVisit[]      @relation("EmergencyCloser")
  prescribedItems      PrescriptionItem[]    @relation("Prescriber")
  suspendedItems       PrescriptionItem[]    @relation("PrescriptionSuspender")
  medicationChecks     MedicationCheck[]     @relation("CheckRecorder")
  canceledChecks       MedicationCheck[]     @relation("CheckCanceler")
  stockMovements       StockMovement[]
  mealsRecorded        MealDelivery[]        @relation("MealRecorder")
  mealsCanceled        MealDelivery[]        @relation("MealCanceler")
  isolationsStarted    IsolationPrecaution[] @relation("IsolationStarter")
  isolationsEnded      IsolationPrecaution[] @relation("IsolationEnder")
  infectionsReported   HospitalInfection[]   @relation("InfectionReporter")
  infectionsCanceled   HospitalInfection[]   @relation("InfectionCanceler")
  chemoPlans           ChemoPlan[]           @relation("ChemoPhysician")
  chemoPlansEnded      ChemoPlan[]           @relation("ChemoPlanEnder")
  chemoReleased        ChemoSession[]        @relation("ChemoReleaser")
  chemoAdministered    ChemoSession[]        @relation("ChemoAdministrator")
  surgeriesAsSurgeon   Surgery[]             @relation("Surgeon")
  surgeriesAsAnesth    Surgery[]             @relation("Anesthetist")
  surgeriesCreated     Surgery[]             @relation("SurgeryCreator")
  surgeriesCanceled    Surgery[]             @relation("SurgeryCanceler")
  surgeryChecks        SurgeryChecklist[]
  sterilizationsRun    SterilizationLoad[]   @relation("LoadOperator")
  sterilizationsJudged SterilizationLoad[]   @relation("LoadJudge")
  packagesUsed         SterilePackage[]      @relation("PackageUser")
  packagesDiscarded    SterilePackage[]      @relation("PackageDiscarder")
  examsRequested       ExamRequest[]         @relation("ExamRequester")
  examsCreated         ExamRequest[]         @relation("ExamCreator")
  examsCollected       ExamRequest[]         @relation("ExamCollector")
  examsReported        ExamRequest[]         @relation("ExamReporter")
  examsCanceled        ExamRequest[]         @relation("ExamCanceler")
  supplyMovements      SupplyMovement[]
  supplyRequests       SupplyRequest[]       @relation("SupplyRequester")
  supplyHandled        SupplyRequest[]       @relation("SupplyHandler")
  workOrdersOpened     WorkOrder[]           @relation("WorkOrderOpener")
  workOrdersClosed     WorkOrder[]           @relation("WorkOrderCloser")
  hospitalBillsClosed  HospitalBill[]
  hospitalBillItems    HospitalBillItem[]
  consultsAsConsultant ConsultRequest[]      @relation("ConsultConsultant")
  consultsRequested    ConsultRequest[]      @relation("ConsultRequester")
  consultsAnswered     ConsultRequest[]      @relation("ConsultAnswerer")
  consultsCanceled     ConsultRequest[]      @relation("ConsultCanceler")
  attendingChangesFrom AttendingChange[]     @relation("AttendingChangeFrom")
  attendingChangesTo   AttendingChange[]     @relation("AttendingChangeTo")
  attendingChangesBy   AttendingChange[]     @relation("AttendingChangeBy")

  @@unique([clinicId, email])
  @@unique([clinicId, cpf])
}

model Session {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  // Último uso: depois de 30 minutos parado, a pessoa precisa entrar de novo.
  lastSeenAt DateTime @default(now())
}

// Sessão do paciente no aplicativo (separada da sessão da equipe).
model PatientSession {
  id        String   @id
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([patientId])
}

model Patient {
  id                   String  @id @default(cuid())
  clinicId             String
  clinic               Clinic  @relation(fields: [clinicId], references: [id])
  // false quando veio do cadastro rápido da recepção e ainda falta completar.
  registrationComplete Boolean @default(true)

  // Identificação
  name          String
  socialName    String?
  // Nome e nome social sem acentos e em minúsculas, para a busca. O banco calcula sozinho
  // (coluna gerada, ver a migração busca_sem_acento): nunca preencher pelo sistema.
  searchName    String?
  birthDate     DateTime?
  sex           String?
  cpf           String?
  rg            String?
  cns           String?
  motherName    String?
  maritalStatus String?
  occupation    String?
  photo         String? // imagem pequena (data URL), reduzida no navegador

  // Contato (telefones guardados só com os números)
  phone                 String?
  phoneWhatsapp         Boolean   @default(true)
  landline              String?
  email                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  // Consentimento (LGPD) para a clínica mandar mensagens pelo WhatsApp, e quando foi dado.
  whatsappOptIn         Boolean   @default(false)
  whatsappOptInAt       DateTime?

  // Endereço
  cep        String?
  street     String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?

  // Convênio ("Particular" quando não há convênio)
  insurance           String?
  // Convênio cadastrado em Financeiro > Convênios (vazio para particular ou convênio não cadastrado).
  // O nome dele também fica em "insurance", que é o que as telas mostram.
  healthPlanId        String?
  healthPlan          HealthPlan? @relation(fields: [healthPlanId], references: [id])
  insuranceNumber     String?
  insuranceValidUntil DateTime?

  // Responsável legal
  guardianName         String?
  guardianCpf          String?
  guardianRelationship String?
  guardianPhone        String?

  // Outros
  referralSource String?
  notes          String?
  lgpdConsentAt  DateTime?

  // Aplicativo do paciente: o paciente entra com CPF e data de nascimento.
  // Depois de várias tentativas erradas seguidas, a entrada fica travada por um tempo.
  appLoginFailures Int       @default(0)
  appLockedUntil   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Resumo clínico, sempre visível no topo do prontuário.
  allergies          String?
  currentMedications String?
  personalHistory    String?
  familyHistory      String?

  encounters        Encounter[]
  charges           Charge[]
  documents         ClinicalDocument[]
  appointments      Appointment[]
  signedPdfs        SignedPdf[]
  teleconsultations Teleconsultation[]
  claims            InsuranceClaim[]
  appSessions       PatientSession[]
  admissions        Admission[]
  emergencyVisits   EmergencyVisit[]
  prescriptionItems PrescriptionItem[]
  stockMovements    StockMovement[]
  chemoPlans        ChemoPlan[]
  chemoSessions     ChemoSession[]
  surgeries         Surgery[]
  examRequests      ExamRequest[]
  consultRequests   ConsultRequest[]

  @@unique([clinicId, cpf])
  @@unique([clinicId, cns])
  @@index([clinicId, name])
}

// Modelo de atendimento (ex.: "Consulta clínica geral", "Psicologia - sessão").
// fields é uma lista de campos: [{ key, label, type: "text" | "textarea" }]
// Cada modelo pertence a um profissional (ownerId), que monta o formulário do seu jeito.
// Sem ownerId, é um modelo da clínica, que todos os profissionais podem usar.
model RecordTemplate {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  name      String
  // Não é mais usado nas telas (os modelos agora são por profissional).
  specialty String?
  fields    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  encounters Encounter[]

  @@index([clinicId, ownerId])
}

// Um atendimento no prontuário. Enquanto RASCUNHO pode ser editado;
// depois de FINALIZADO fica imutável e só aceita adendos.
model Encounter {
  id             String          @id @default(cuid())
  clinicId       String
  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  professionalId String
  professional   User            @relation(fields: [professionalId], references: [id])
  templateId     String?
  template       RecordTemplate? @relation(fields: [templateId], references: [id])
  // Cópia dos campos do modelo no momento do atendimento, para que mudar o
  // modelo depois não altere atendimentos antigos.
  fields         Json
  content        Json            @default("{}")
  diagnoses      Json            @default("[]")
  // Sinais vitais (PA, FC, peso, altura...). Vazio em atendimentos antigos.
  vitals         Json?
  status         EncounterStatus @default(RASCUNHO)
  startedAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  finalizedAt    DateTime?
  // Impressão digital (SHA-256) do conteúdo finalizado, para detectar adulteração.
  contentHash    String?
  // Hospital: evolução de paciente internado (médica, de enfermagem por turno ou multiprofissional).
  admissionId    String?
  admission      Admission?      @relation(fields: [admissionId], references: [id])
  evolutionKind  EvolutionKind?
  shift          Shift?

  addenda          Addendum[]
  documents        ClinicalDocument[]
  charges          Charge[]
  appointment      Appointment?
  signedPdf        SignedPdf?
  teleconsultation Teleconsultation?
  claims           InsuranceClaim[]
  emergencyVisit   EmergencyVisit?

  @@index([clinicId, patientId, startedAt])
  @@index([admissionId])
}

// Receita, atestado, pedido de exame ou relatório emitido num atendimento.
// Depois de emitido não pode ser alterado nem apagado (o banco bloqueia).
// É este texto que vira PDF e, mais à frente, recebe a assinatura ICP-Brasil.
model ClinicalDocument {
  id          String       @id @default(cuid())
  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  // Vazio quando o laudo (APAC, AIH, LME) foi emitido direto pela ficha do paciente, sem atendimento.
  encounterId String?
  encounter   Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id])
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  type        DocumentType
  body        String
  // Respostas de cada campo do laudo, para escrever no formulário oficial.
  fields      Json?
  createdAt   DateTime     @default(now())
  // Impressão digital (SHA-256) do texto emitido, como nos atendimentos.
  contentHash String

  signedPdf SignedPdf?

  @@index([encounterId])
  @@index([patientId])
}

// Autorização que o profissional deu no app do certificado (BirdID, VIDaaS)
// para o sistema assinar por algumas horas sem pedir confirmação a cada documento.
model SignatureSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String
  // Guardado cifrado: quem ler o banco não consegue assinar.
  accessToken      String
  certificateAlias String
  // Certificado do profissional e cadeia, em base64, separados por vírgula.
  certificateChain String
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@unique([userId, provider])
}

// PDF assinado com certificado ICP-Brasil. Não pode ser alterado nem apagado.
model SignedPdf {
  id                String            @id @default(cuid())
  clinicId          String
  clinic            Clinic            @relation(fields: [clinicId], references: [id])
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id])
  encounterId       String?           @unique
  encounter         Encounter?        @relation(fields: [encounterId], references: [id])
  documentId        String?           @unique
  document          ClinicalDocument? @relation(fields: [documentId], references: [id])
  signerId          String
  signer            User              @relation(fields: [signerId], references: [id])
  provider          String
  signerName        String
  signerCpf         String?
  certificateSerial String
  pdf               Bytes
  sha256            String
  signedAt          DateTime          @default(now())
  // Registros do hospital (prescrição do dia, enfermagem, triagem, alta, cirurgia, exame, quimio, parecer).
  // recordHash muda quando o registro ganha algo novo: aí ele volta a ficar pendente de assinatura.
  recordType        String?
  recordKey         String?
  recordHash        String?

  @@index([clinicId, recordType, recordKey])
  @@index([signerId, signedAt])
}

// Atendimento por vídeo (Resolução CFM 2.314/2022). A teleconsulta nasce na agenda
// (tipo "Teleconsulta") ou direto no prontuário, e fica ligada ao atendimento do
// prontuário onde o profissional escreve normalmente.
// O paciente entra por um link secreto, sem senha, e precisa aceitar o termo
// de consentimento antes de ver a chamada. O vídeo não é gravado.
model Teleconsultation {
  id                   String       @id @default(cuid())
  clinicId             String
  clinic               Clinic       @relation(fields: [clinicId], references: [id])
  patientId            String
  patient              Patient      @relation(fields: [patientId], references: [id])
  professionalId       String
  professional         User         @relation(fields: [professionalId], references: [id])
  // Vazio enquanto a consulta marcada na agenda ainda não começou.
  encounterId          String?      @unique
  encounter            Encounter?   @relation(fields: [encounterId], references: [id])
  appointmentId        String?      @unique
  appointment          Appointment? @relation(fields: [appointmentId], references: [id])
  // Código do link enviado ao paciente.
  token                String       @unique
  expiresAt            DateTime
  // Sala na empresa de vídeo (Daily), criada quando alguém entra pela primeira vez.
  roomName             String?
  roomUrl              String?
  // Termo aceito pelo paciente: o texto exato, quando e de onde.
  consentText          String?
  consentAt            DateTime?
  consentIp            String?
  consentDevice        String?
  professionalJoinedAt DateTime?
  patientJoinedAt      DateTime?
  endedAt              DateTime?
  createdAt            DateTime     @default(now())

  @@index([clinicId, patientId])
}

model Addendum {
  id          String    @id @default(cuid())
  encounterId String
  encounter   Encounter @relation(fields: [encounterId], references: [id])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  text        String
  createdAt   DateTime  @default(now())
}

// Trilha de auditoria (LGPD): quem viu ou alterou o quê, e quando.
model AuditLog {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  patientId String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([clinicId, patientId])
}

// Texto pronto de cada profissional ("usar modelo" ao lado de cada campo).
// fieldKey vazio: o texto aparece em todos os campos.
model TextSnippet {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  fieldKey  String?
  title     String
  text      String
  createdAt DateTime @default(now())

  @@index([ownerId, fieldKey])
}

// Tabela de preços: quanto custa cada consulta ou procedimento.
// Valores sempre em centavos, para não haver erro de arredondamento.
model PriceItem {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  name       String
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  charges Charge[]
}

// Receita: uma cobrança feita a um paciente, normalmente ligada a um atendimento.
model Charge {
  id              String          @id @default(cuid())
  clinicId        String
  clinic          Clinic          @relation(fields: [clinicId], references: [id])
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id])
  // Profissional que fez o atendimento; é a base do repasse.
  professionalId  String?
  professional    User?           @relation(fields: [professionalId], references: [id])
  encounterId     String?
  encounter       Encounter?      @relation(fields: [encounterId], references: [id])
  priceItemId     String?
  priceItem       PriceItem?      @relation(fields: [priceItemId], references: [id])
  description     String
  amountCents     Int
  dueDate         DateTime        @db.Date
  status          FinanceStatus   @default(PENDENTE)
  paymentMethod   PaymentMethod?
  paidAt          DateTime?       @db.Date
  receiptNumber   Int?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  claim           InsuranceClaim?
  claimAppeal     ClaimAppeal?
  // Dia em que o profissional (pessoa física) lançou o recibo no Receita Saúde, da Receita Federal.
  healthReceiptAt DateTime?       @db.Date
  serviceInvoice  ServiceInvoice?
  hospitalBill    HospitalBill?

  @@unique([clinicId, receiptNumber])
  @@index([clinicId, dueDate])
  @@index([clinicId, paidAt])
  @@index([encounterId])
}

// Nota fiscal de serviço (NFS-e) de uma cobrança paga, pedida pelo paciente.
// Por enquanto a nota é emitida fora do sistema (emissor nacional) e aqui se anota o número;
// mais adiante um provedor (ex.: Focus NFe) emitirá direto daqui, preenchendo providerRef.
model ServiceInvoice {
  id               String               @id @default(cuid())
  clinicId         String
  clinic           Clinic               @relation(fields: [clinicId], references: [id])
  chargeId         String               @unique
  charge           Charge               @relation(fields: [chargeId], references: [id])
  // Quem emite, guardado no pedido: mudar a configuração da clínica não muda notas já pedidas.
  issuer           InvoiceIssuer
  status           ServiceInvoiceStatus @default(PEDIDA)
  requestedAt      DateTime             @default(now())
  requestedById    String
  number           String?
  verificationCode String?
  issuedAt         DateTime?
  issuedById       String?
  provider         String               @default("manual")
  providerRef      String?
  // Emissão automática: "processando" enquanto a prefeitura analisa, "erro" com o motivo em providerMessage.
  providerStatus   String?
  providerMessage  String?
  // Consulta pública da nota no portal nacional e PDF (DANFSe).
  url              String?
  pdfUrl           String?
  attempts         Int                  @default(0)
  notes            String?

  @@index([clinicId, status])
}

// Despesa: conta a pagar da clínica (aluguel, salários, materiais, repasses...).
model Expense {
  id            String         @id @default(cuid())
  clinicId      String
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  description   String
  category      String
  amountCents   Int
  dueDate       DateTime       @db.Date
  status        FinanceStatus  @default(PENDENTE)
  paymentMethod PaymentMethod?
  paidAt        DateTime?      @db.Date
  notes         String?
  // Parcela de uma nota fiscal de compra (aba Compras), quando houver.
  purchaseId    String?
  purchase      Purchase?      @relation(fields: [purchaseId], references: [id])
  installment   Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([clinicId, dueDate])
  @@index([clinicId, paidAt])
  @@index([purchaseId])
}

// Nota fiscal de compra (material, medicamento, insumo...). O pagamento vira uma ou mais
// despesas (parcelas) na aba Despesas.
model Purchase {
  id            String         @id @default(cuid())
  clinicId      String
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  kind          String
  supplierName  String
  supplierCnpj  String?
  invoiceNumber String
  invoiceSeries String?
  accessKey     String?
  issueDate     DateTime       @db.Date
  totalCents    Int
  notes         String?
  status        PurchaseStatus @default(ATIVA)
  createdById   String
  createdAt     DateTime       @default(now())

  items    PurchaseItem[]
  expenses Expense[]

  @@index([clinicId, issueDate])
  @@index([clinicId, supplierCnpj, invoiceNumber])
}

enum PurchaseStatus {
  ATIVA
  CANCELADA
}

model PurchaseItem {
  id             String    @id @default(cuid())
  purchaseId     String
  purchase       Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  position       Int
  description    String
  unit           String?
  quantity       Decimal   @db.Decimal(12, 3)
  unitPriceCents Int
  totalCents     Int
  // Lote e validade (importante para medicamentos e insumos).
  batch          String?
  expiresAt      DateTime? @db.Date
}

// Horário de atendimento de um profissional num dia da semana (0 = domingo).
// Um profissional pode ter mais de um período no mesmo dia (manhã e tarde).
// Horários em minutos desde a meia-noite, no horário de Brasília.
model WorkHours {
  id             String @id @default(cuid())
  clinicId       String
  clinic         Clinic @relation(fields: [clinicId], references: [id])
  professionalId String
  professional   User   @relation(fields: [professionalId], references: [id])
  weekday        Int
  startMinute    Int
  endMinute      Int
  // Duração padrão de cada consulta neste período.
  slotMinutes    Int

  @@index([clinicId, professionalId])
}

// Período em que o profissional não atende (almoço, férias, congresso...).
model ScheduleBlock {
  id             String   @id @default(cuid())
  clinicId       String
  clinic         Clinic   @relation(fields: [clinicId], references: [id])
  professionalId String
  professional   User     @relation(fields: [professionalId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  createdAt      DateTime @default(now())

  @@index([clinicId, professionalId, startsAt])
}

model Appointment {
  id                 String            @id @default(cuid())
  clinicId           String
  clinic             Clinic            @relation(fields: [clinicId], references: [id])
  professionalId     String
  professional       User              @relation("AppointmentProfessional", fields: [professionalId], references: [id])
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  startsAt           DateTime
  endsAt             DateTime
  type               AppointmentType   @default(CONSULTA)
  // Vazio = particular; preenchido = nome do convênio.
  insurance          String?
  notes              String?
  status             AppointmentStatus @default(AGENDADO)
  arrivedAt          DateTime?
  cancelReason       String?
  // Quando o próprio paciente confirmou ou desmarcou pelo aplicativo (aparece como "pelo app").
  confirmedInAppAt   DateTime?
  cancelledInAppAt   DateTime?
  // WhatsApp: quando a recepção pediu a confirmação desta consulta.
  confirmationSentAt DateTime?
  // Retorno previsto depois desta consulta e quando o paciente foi avisado.
  returnDueOn        DateTime?         @db.Date
  returnNoticeSentAt DateTime?
  // Atendimento do prontuário aberto a partir deste agendamento.
  encounterId        String?           @unique
  encounter          Encounter?        @relation(fields: [encounterId], references: [id])
  teleconsultation   Teleconsultation?
  // Vazio quando o próprio paciente marcou pelo aplicativo (createdInAppAt).
  createdById        String?
  createdBy          User?             @relation("AppointmentCreator", fields: [createdById], references: [id])
  createdInAppAt     DateTime?
  rescheduledInAppAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([clinicId, startsAt])
  @@index([clinicId, professionalId, startsAt])
  @@index([clinicId, patientId])
  @@index([clinicId, returnDueOn])
}

model Cid10 {
  code        String @id
  description String

  @@index([description])
}

// Tabela de procedimentos do SUS (SIGTAP), para buscar o código nos laudos APAC e AIH.
// Carregada de prisma/data/sigtap.tsv (ver seed.ts).
model SigtapProcedure {
  code       String  @id
  name       String
  // Nome sem acentos e em minúsculas, para a busca. O banco calcula sozinho
  // (coluna gerada, ver a migração procedimentos_sigtap): nunca preencher pelo sistema.
  searchName String?
}

// ---------- Contabilidade e parte trabalhista ----------

// Dados de contrato de trabalho de um servidor. A pessoa em si (nome, CPF, função, setor,
// desligamento) está no cadastro de servidores (User); aqui fica só o que é trabalhista.
model EmploymentContract {
  id            String         @id @default(cuid())
  clinicId      String
  clinic        Clinic         @relation(fields: [clinicId], references: [id])
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  type          EmploymentType @default(CLT)
  admissionDate DateTime       @db.Date
  salaryCents   Int
  weeklyHours   Int?
  pis           String?
  // Chave Pix ou dados bancários para o pagamento do salário.
  paymentInfo   String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  vacations      Vacation[]
  payrollEntries PayrollEntry[]

  @@index([clinicId])
}

// Férias tiradas (ou marcadas) por um funcionário.
model Vacation {
  id         String             @id @default(cuid())
  clinicId   String
  clinic     Clinic             @relation(fields: [clinicId], references: [id])
  contractId String
  contract   EmploymentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  startDate  DateTime           @db.Date
  endDate    DateTime           @db.Date
  notes      String?
  createdAt  DateTime           @default(now())

  @@index([contractId, startDate])
}

// Uma linha da folha do mês: o que aconteceu com o funcionário no mês (faltas, horas extras...),
// para enviar ao contador, e o valor líquido que o contador devolve.
model PayrollEntry {
  id              String             @id @default(cuid())
  clinicId        String
  clinic          Clinic             @relation(fields: [clinicId], references: [id])
  contractId      String
  contract        EmploymentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  // Mês de competência, no formato aaaa-mm.
  month           String
  baseCents       Int
  absenceDays     Int                @default(0)
  overtimeHours   Int                @default(0)
  additionsCents  Int                @default(0)
  deductionsCents Int                @default(0)
  netCents        Int?
  notes           String?
  // Despesa criada no Financeiro quando o salário foi lançado.
  expenseId       String?
  updatedAt       DateTime           @updatedAt

  @@unique([contractId, month])
  @@index([clinicId, month])
}

// Obrigação que se repete todo mês (ou todo ano): impostos, FGTS, eSocial, salários...
model TaxObligation {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  name        String
  // "Imposto", "Trabalhista" ou "Envio" (declarações e documentos, sem valor a pagar).
  kind        String
  dueDay      Int
  // true: dueDay é o n-ésimo dia útil (ex.: salário até o 5º dia útil).
  businessDay Boolean  @default(false)
  // Só para obrigações anuais: o mês (1 a 12) em que vencem.
  onlyMonth   Int?
  hint        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  entries ObligationEntry[]
}

// Registro de que a obrigação de um mês foi cumprida.
model ObligationEntry {
  id           String        @id @default(cuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  obligationId String
  obligation   TaxObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  month        String
  doneAt       DateTime      @db.Date
  amountCents  Int?
  expenseId    String?
  notes        String?
  createdAt    DateTime      @default(now())

  @@unique([obligationId, month])
}

// Texto que a clínica escreveu para uma mensagem padrão do WhatsApp
// (contato, confirmacao, retorno). Sem registro = texto padrão do sistema.
model WhatsappMessage {
  id          String   @id @default(cuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  key         String
  text        String
  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@unique([clinicId, key])
}

// Convênio (operadora de plano de saúde) com que a clínica trabalha, para o faturamento no padrão TISS da ANS.
model HealthPlan {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id])
  name         String
  // Registro da operadora na ANS (6 números), que vai em toda guia.
  ansCode      String?
  // Código que a operadora deu à clínica ("código do prestador na operadora").
  providerCode String?
  // Dias que a operadora leva para pagar depois do envio do lote.
  paymentDays  Int?
  // Dias em que a volta do paciente conta como retorno, sem nova cobrança.
  returnDays   Int?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prices   HealthPlanPrice[]
  patients Patient[]
  claims   InsuranceClaim[]
  batches  ClaimBatch[]

  @@unique([clinicId, name])
}

// Preço combinado com o convênio para cada procedimento, pelo código da tabela TUSS (8 números).
model HealthPlanPrice {
  id           String     @id @default(cuid())
  healthPlanId String
  healthPlan   HealthPlan @relation(fields: [healthPlanId], references: [id])
  tussCode     String
  description  String
  priceCents   Int
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([healthPlanId, tussCode])
}

// Procedimento ou exame de uma guia SP/SADT.
model ClaimItem {
  id          String         @id @default(cuid())
  clinicId    String
  clinic      Clinic         @relation(fields: [clinicId], references: [id])
  claimId     String
  claim       InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sequence    Int
  tussCode    String
  description String
  quantity    Int
  unitCents   Int
  totalCents  Int

  @@unique([claimId, sequence])
}

// Recurso de glosa: a clínica contesta o que o convênio não pagou e, se ele aceitar, registra o valor recuperado.
model ClaimAppeal {
  id             String         @id @default(cuid())
  clinicId       String
  clinic         Clinic         @relation(fields: [clinicId], references: [id])
  claimId        String         @unique
  claim          InsuranceClaim @relation(fields: [claimId], references: [id])
  reason         String
  sentAt         DateTime       @db.Date
  // Protocolo que o portal do convênio deu ao receber o recurso.
  protocol       String?
  // Resposta do convênio: quanto pagou a mais (zero se negou) e quando.
  resolvedAt     DateTime?      @db.Date
  recoveredCents Int?
  // Receita lançada no Financeiro com o valor recuperado.
  chargeId       String?        @unique
  charge         Charge?        @relation(fields: [chargeId], references: [id])
  createdAt      DateTime       @default(now())
}

enum ClaimKind {
  CONSULTA
  SPSADT
}

enum ClaimStatus {
  ABERTA
  CANCELADA
}

// Guia de consulta (padrão TISS) cobrada do convênio por um atendimento.
model InsuranceClaim {
  id                 String       @id @default(cuid())
  clinicId           String
  clinic             Clinic       @relation(fields: [clinicId], references: [id])
  healthPlanId       String
  healthPlan         HealthPlan   @relation(fields: [healthPlanId], references: [id])
  patientId          String
  patient            Patient      @relation(fields: [patientId], references: [id])
  professionalId     String
  professional       User         @relation(fields: [professionalId], references: [id])
  encounterId        String?
  encounter          Encounter?   @relation(fields: [encounterId], references: [id])
  // Guia de consulta ou SP/SADT (exames e procedimentos, com vários itens).
  kind               ClaimKind    @default(CONSULTA)
  // Número da guia no prestador (sequência da clínica).
  number             Int
  // Número ou senha que o convênio deu para o atendimento, quando dá.
  operatorNumber     String?
  // Carteirinha no dia do atendimento.
  cardNumber         String
  cardValidUntil     DateTime?    @db.Date
  newborn            Boolean      @default(false)
  serviceDate        DateTime     @db.Date
  // Tabela 52 da TISS (1 primeira consulta, 2 seguimento, 3 pré-natal, 4 encaminhamento). Só na guia de consulta.
  consultationType   Int?
  // Tabela 36 da TISS (9 = não foi acidente).
  accidentIndication Int          @default(9)
  // Regime de atendimento da TISS: 01 ambulatorial, 05 telessaúde.
  careRegime         String       @default("01")
  // CBO do profissional que atendeu.
  cbo                String
  // Na guia SP/SADT, código e descrição do primeiro item e soma dos itens.
  tussCode           String
  description        String
  amountCents        Int
  notes              String?
  // Só na SP/SADT: tipo de atendimento (tabela 50), caráter (urgência ou eletivo), indicação clínica,
  // data do pedido e a autorização do convênio (data e senha), quando ele exige.
  serviceType        String?
  urgent             Boolean      @default(false)
  clinicalIndication String?
  requestDate        DateTime?    @db.Date
  authorizationDate  DateTime?    @db.Date
  authorizationCode  String?
  items              ClaimItem[]
  appeal             ClaimAppeal?
  status             ClaimStatus  @default(ABERTA)
  canceledAt         DateTime?
  // Lote em que a guia foi enviada ao convênio. Guia em lote não pode ser cancelada.
  batchId            String?
  batch              ClaimBatch?  @relation(fields: [batchId], references: [id])
  // Conferência do pagamento: quanto o convênio pagou e, se pagou menos, o motivo da glosa.
  paidCents          Int?
  glossReason        String?
  // Receita lançada no Financeiro com o valor pago.
  chargeId           String?      @unique
  charge             Charge?      @relation(fields: [chargeId], references: [id])
  createdAt          DateTime     @default(now())

  @@unique([clinicId, number])
  @@index([clinicId, serviceDate])
  @@index([encounterId])
}

// ---- Painel do dono do sistema ----
// Equipe da empresa que vende o sistema. Fica separada dos usuários das clínicas:
// cadastra e suspende clínicas, mas não tem acesso a pacientes nem ao prontuário (LGPD).
// Problemas do sistema para a empresa dona olhar no Painel do dono: erros registrados
// automaticamente e relatos feitos pelo botão "Relatar problema". O mesmo erro repetido
// não cria uma linha nova a cada vez: soma em `count` e atualiza `lastSeenAt`.
model ProblemReport {
  id          String    @id @default(cuid())
  // ERRO (automático) ou RELATO (alguém da clínica escreveu).
  kind        String
  clinicId    String?
  clinic      Clinic?   @relation(fields: [clinicId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  message     String
  // Tela em que aconteceu (endereço, sem os parâmetros).
  page        String?
  // Código que o Next.js mostra na tela de erro; liga o relato ao erro registrado.
  digest      String?
  details     String?
  fingerprint String?
  count       Int       @default(1)
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([resolvedAt, lastSeenAt])
  @@index([fingerprint])
}

model PlatformUser {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  // Dono: além de cuidar das clínicas, cadastra e bloqueia a equipe do painel.
  owner              Boolean   @default(false)
  // Senha provisória (criada pelo dono ou fraca): precisa trocar antes de usar o painel.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  // Verificação em duas etapas, como a dos usuários das clínicas (segredo cifrado).
  totpSecret         String?
  totpEnabledAt      DateTime?
  totpLastStep       Int?
  totpRecoveryCodes  String[]  @default([])

  sessions           PlatformSession[]
  auditLogs          PlatformAuditLog[]
  paymentsRegistered ClinicPayment[]    @relation("PaymentRegisteredBy")
  paymentsCanceled   ClinicPayment[]    @relation("PaymentCanceledBy")
  notices            PlatformNotice[]
}

model PlatformSession {
  id        String       @id
  userId    String
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())
}

// O que a equipe da empresa fez no painel. Como a auditoria das clínicas, não pode ser apagado.
model PlatformAuditLog {
  id        String        @id @default(cuid())
  userId    String?
  user      PlatformUser? @relation(fields: [userId], references: [id])
  action    String
  clinicId  String?
  details   Json?
  ip        String?
  createdAt DateTime      @default(now())

  @@index([createdAt])
}

// Lote de guias enviado a um convênio: um arquivo XML no padrão TISS.
model ClaimBatch {
  id           String     @id @default(cuid())
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  healthPlanId String
  healthPlan   HealthPlan @relation(fields: [healthPlanId], references: [id])
  number       Int
  // Um lote leva só um tipo de guia (regra da TISS).
  kind         ClaimKind  @default(CONSULTA)
  tissVersion  String
  createdAt    DateTime   @default(now())
  // Número de protocolo que o portal do convênio deu ao receber o arquivo.
  protocol     String?
  // Dia em que o convênio pagou o lote (preenchido na conferência do pagamento).
  paidAt       DateTime?  @db.Date

  claims InsuranceClaim[]

  @@unique([clinicId, number])
}

// Plano vendido às clínicas no Painel do dono. modules: módulos opcionais liberados (ver src/lib/plans.ts).
model Plan {
  id         String   @id @default(cuid())
  name       String   @unique
  priceCents Int
  // Máximo de pessoas com acesso ao sistema na clínica. Vazio = sem limite.
  maxUsers   Int?
  modules    String[] @default([])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  clinics Clinic[]
}

// Mensalidade que a clínica pagou à empresa, registrada à mão no Painel do dono.
// previousPaidUntil/paidUntil: o "pago até" antes e depois, para poder desfazer um lançamento errado.
model ClinicPayment {
  id                String        @id @default(cuid())
  clinicId          String
  clinic            Clinic        @relation(fields: [clinicId], references: [id])
  amountCents       Int
  paidAt            DateTime      @db.Date
  // pix, boleto, cartao, transferencia, dinheiro
  method            String
  notes             String?
  previousPaidUntil DateTime?     @db.Date
  paidUntil         DateTime      @db.Date
  createdById       String
  createdBy         PlatformUser  @relation("PaymentRegisteredBy", fields: [createdById], references: [id])
  createdAt         DateTime      @default(now())
  canceledAt        DateTime?
  canceledById      String?
  canceledBy        PlatformUser? @relation("PaymentCanceledBy", fields: [canceledById], references: [id])
  cancelReason      String?

  @@index([clinicId, createdAt])
  @@index([paidAt])
}

// Aviso da empresa para as clínicas (manutenção, novidade, cobrança), escrito no Painel do dono.
// clinicId vazio = todas as clínicas. audience: "todos" ou "gerentes" (só o gerente do sistema da clínica).
model PlatformNotice {
  id          String       @id @default(cuid())
  title       String
  body        String
  // info, novidade, manutencao, importante
  kind        String       @default("info")
  audience    String       @default("todos")
  clinicId    String?
  clinic      Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  startsAt    DateTime     @default(now())
  endsAt      DateTime?
  createdById String
  createdBy   PlatformUser @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  dismissals NoticeDismissal[]

  @@index([startsAt])
}

// Quem já fechou o aviso ("Entendi"), para não aparecer de novo para essa pessoa.
model NoticeDismissal {
  noticeId  String
  notice    PlatformNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([noticeId, userId])
}

// ---- Hospital: internação e leitos (só aparece para instituição do tipo HOSPITAL) ----

// Situação do leito vazio. Ocupado não é guardado aqui: o leito está ocupado quando tem internação sem alta.
enum BedStatus {
  LIVRE
  // Depois da alta o leito vai para limpeza; alguém marca "leito limpo" para liberar.
  LIMPEZA
  BLOQUEADO
}

enum DischargeKind {
  MELHORADO
  A_PEDIDO
  TRANSFERENCIA
  OBITO
  EVASAO
}

// Ala ou setor de internação (ex.: Enfermaria clínica, UTI adulto, Apartamentos).
model Ward {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  name      String
  kind      String   @default("Enfermaria")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  beds Bed[]

  @@unique([clinicId, name])
}

model Bed {
  id         String    @id @default(cuid())
  clinicId   String
  clinic     Clinic    @relation(fields: [clinicId], references: [id])
  wardId     String
  ward       Ward      @relation(fields: [wardId], references: [id])
  code       String
  status     BedStatus @default(LIVRE)
  // Motivo do bloqueio (ex.: manutenção do ar-condicionado, isolamento).
  statusNote String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  admissions    Admission[]
  movementsFrom BedMovement[] @relation("MovementFrom")
  movementsTo   BedMovement[] @relation("MovementTo")

  @@unique([wardId, code])
}

// Internação: do dia em que o paciente ocupa o leito até a alta. bedId é o leito atual.
// No banco, um leito e um paciente só podem ter uma internação sem alta de cada vez.
model Admission {
  id             String         @id @default(cuid())
  clinicId       String
  clinic         Clinic         @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id])
  bedId          String
  bed            Bed            @relation(fields: [bedId], references: [id])
  // Médico responsável pela internação.
  attendingId    String
  attending      User           @relation("AdmissionAttending", fields: [attendingId], references: [id])
  // Especialidade (clínica) que cuida do paciente agora, ex.: Clínica médica, Cirurgia geral.
  // Muda quando o paciente é transferido de especialidade (ver AttendingChange).
  specialty      String?
  admittedById   String
  admittedBy     User           @relation("AdmissionCreator", fields: [admittedById], references: [id])
  admittedAt     DateTime       @default(now())
  // De onde veio: pronto-socorro, ambulatório, transferência de outro hospital, eletiva...
  origin         String
  reason         String?
  cidCode        String?
  cidDescription String?
  // SUS, nome do convênio ou particular.
  insurance      String?
  dischargedAt   DateTime?
  dischargeKind  DischargeKind?
  dischargeNote  String?
  dischargedById String?
  dischargedBy   User?          @relation("AdmissionDischarger", fields: [dischargedById], references: [id])
  createdAt      DateTime       @default(now())

  movements         BedMovement[]
  visits            Visit[]
  meals             MealDelivery[]
  isolations        IsolationPrecaution[]
  infections        HospitalInfection[]
  surgeries         Surgery[]
  exams             ExamRequest[]
  evolutions        Encounter[]
  vitalRecords      VitalRecord[]
  fluidEntries      FluidEntry[]
  prescriptionItems PrescriptionItem[]
  bill              HospitalBill?
  consults          ConsultRequest[]
  attendingChanges  AttendingChange[]

  @@index([clinicId, dischargedAt])
}

// Histórico de leitos de cada internação (entrada no primeiro leito e cada troca).
model BedMovement {
  id          String    @id @default(cuid())
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id])
  fromBedId   String?
  fromBed     Bed?      @relation("MovementFrom", fields: [fromBedId], references: [id])
  toBedId     String
  toBed       Bed       @relation("MovementTo", fields: [toBedId], references: [id])
  movedAt     DateTime  @default(now())
  movedById   String
  movedBy     User      @relation(fields: [movedById], references: [id])
  note        String?
}

// Visita a paciente internado, registrada pela recepção na entrada e na saída.
model Visit {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id])
  admissionId     String
  admission       Admission @relation(fields: [admissionId], references: [id])
  visitorName     String
  // Documento do visitante (RG ou CPF), como a portaria pede.
  visitorDocument String?
  relationship    String?
  enteredAt       DateTime  @default(now())
  leftAt          DateTime?
  registeredById  String
  registeredBy    User      @relation(fields: [registeredById], references: [id])

  @@index([clinicId, enteredAt])
}

enum EvolutionKind {
  MEDICA
  ENFERMAGEM
  MULTIPROFISSIONAL
}

enum Shift {
  MANHA
  TARDE
  NOITE
}

// Sinais vitais do paciente internado, aferidos pela enfermagem ao longo do dia.
// Registro de prontuário: não muda nem é apagado; um lançamento errado é anulado com o motivo.
model VitalRecord {
  id           String    @id @default(cuid())
  clinicId     String
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  admissionId  String
  admission    Admission @relation(fields: [admissionId], references: [id])
  takenAt      DateTime
  vitals       Json
  // Escala de dor de 0 a 10.
  pain         Int?
  note         String?
  recordedById String
  recordedBy   User      @relation("VitalRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())
  canceledAt   DateTime?
  canceledById String?
  canceledBy   User?     @relation("VitalCanceler", fields: [canceledById], references: [id])
  cancelReason String?

  @@index([admissionId, takenAt])
}

enum FluidDirection {
  ENTRADA
  SAIDA
}

// Balanço hídrico: cada entrada (soro, dieta, água...) ou saída (diurese, dreno, vômito...) em mL.
// Mesmo cuidado dos sinais vitais: não muda nem é apagado, só anulado.
model FluidEntry {
  id           String         @id @default(cuid())
  clinicId     String
  clinic       Clinic         @relation(fields: [clinicId], references: [id])
  admissionId  String
  admission    Admission      @relation(fields: [admissionId], references: [id])
  at           DateTime
  direction    FluidDirection
  kind         String
  volumeMl     Int
  note         String?
  recordedById String
  recordedBy   User           @relation("FluidRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime       @default(now())
  canceledAt   DateTime?
  canceledById String?
  canceledBy   User?          @relation("FluidCanceler", fields: [canceledById], references: [id])
  cancelReason String?

  @@index([admissionId, at])
}

// ---- Pronto-socorro (hospital) ----

// Classificação de risco na triagem (cores do Protocolo de Manchester).
enum RiskLevel {
  VERMELHO
  LARANJA
  AMARELO
  VERDE
  AZUL
}

enum EmergencyStatus {
  AGUARDANDO_TRIAGEM
  AGUARDANDO_MEDICO
  EM_ATENDIMENTO
  OBSERVACAO
  ENCERRADO
}

enum EmergencyOutcome {
  ALTA
  INTERNACAO
  TRANSFERENCIA
  OBITO
  EVASAO
}

// Uma passagem do paciente pelo pronto-socorro: chegada (recepção), triagem (enfermagem),
// atendimento (médico) e desfecho. Só uma passagem aberta por paciente.
model EmergencyVisit {
  id                String             @id @default(cuid())
  clinicId          String
  clinic            Clinic             @relation(fields: [clinicId], references: [id])
  patientId         String
  patient           Patient            @relation(fields: [patientId], references: [id])
  arrivedAt         DateTime           @default(now())
  complaint         String
  arrivalMode       String?
  companion         String?
  registeredById    String
  registeredBy      User               @relation("EmergencyRegistrar", fields: [registeredById], references: [id])
  status            EmergencyStatus    @default(AGUARDANDO_TRIAGEM)
  risk              RiskLevel?
  triagedAt         DateTime?
  triagedById       String?
  triagedBy         User?              @relation("EmergencyTriager", fields: [triagedById], references: [id])
  triageVitals      Json?
  pain              Int?
  triageNote        String?
  calledAt          DateTime?
  doctorId          String?
  doctor            User?              @relation("EmergencyDoctor", fields: [doctorId], references: [id])
  encounterId       String?            @unique
  encounter         Encounter?         @relation(fields: [encounterId], references: [id])
  outcome           EmergencyOutcome?
  closedAt          DateTime?
  closedById        String?
  closedBy          User?              @relation("EmergencyCloser", fields: [closedById], references: [id])
  closeNote         String?
  prescriptionItems PrescriptionItem[]
  exams             ExamRequest[]

  @@index([clinicId, status])
  @@index([clinicId, arrivedAt])
}

// ---- Prescrição hospitalar e checagem (internação e pronto-socorro) ----

enum PrescriptionKind {
  MEDICAMENTO
  CUIDADO
  DIETA
}

enum CheckStatus {
  FEITO
  NAO_FEITO
}

// Um item da prescrição do médico. Depois de prescrito não muda: para corrigir, suspende e prescreve de novo.
// Sem intervalo e sem "se necessário" = dose única no início.
model PrescriptionItem {
  id               String            @id @default(cuid())
  clinicId         String
  clinic           Clinic            @relation(fields: [clinicId], references: [id])
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id])
  admissionId      String?
  admission        Admission?        @relation(fields: [admissionId], references: [id])
  emergencyVisitId String?
  emergencyVisit   EmergencyVisit?   @relation(fields: [emergencyVisitId], references: [id])
  prescriberId     String
  prescriber       User              @relation("Prescriber", fields: [prescriberId], references: [id])
  kind             PrescriptionKind  @default(MEDICAMENTO)
  description      String
  dose             String?
  route            String?
  intervalHours    Int?
  asNeeded         Boolean           @default(false)
  startAt          DateTime
  endAt            DateTime?
  note             String?
  createdAt        DateTime          @default(now())
  suspendedAt      DateTime?
  suspendedById    String?
  suspendedBy      User?             @relation("PrescriptionSuspender", fields: [suspendedById], references: [id])
  suspendReason    String?
  checks           MedicationCheck[]
  dispensations    StockMovement[]

  @@index([admissionId])
  @@index([emergencyVisitId])
}

// Checagem da enfermagem: feito ou não feito (com motivo). Não muda nem some; só pode ser anulada.
model MedicationCheck {
  id           String           @id @default(cuid())
  clinicId     String
  clinic       Clinic           @relation(fields: [clinicId], references: [id])
  itemId       String
  item         PrescriptionItem @relation(fields: [itemId], references: [id])
  scheduledAt  DateTime?
  status       CheckStatus
  at           DateTime         @default(now())
  note         String?
  recordedById String
  recordedBy   User             @relation("CheckRecorder", fields: [recordedById], references: [id])
  canceledAt   DateTime?
  canceledById String?
  canceledBy   User?            @relation("CheckCanceler", fields: [canceledById], references: [id])
  cancelReason String?

  @@index([itemId])
}

// ---- Farmácia hospitalar ----

enum StockMovementKind {
  ENTRADA
  DISPENSACAO
  DEVOLUCAO
  AJUSTE
  PERDA
}

// Medicamento ou material da farmácia. O saldo é a soma das movimentações.
model PharmacyProduct {
  id           String          @id @default(cuid())
  clinicId     String
  clinic       Clinic          @relation(fields: [clinicId], references: [id])
  name         String
  presentation String?
  unit         String          @default("unidade")
  minStock     Int             @default(0)
  controlled   Boolean         @default(false)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  movements    StockMovement[]

  @@unique([clinicId, name, presentation])
}

// Cada entrada, saída, ajuste ou perda, por lote. Não muda nem some: erro se corrige com um ajuste.
// quantity: positiva entra, negativa sai.
model StockMovement {
  id                 String            @id @default(cuid())
  clinicId           String
  clinic             Clinic            @relation(fields: [clinicId], references: [id])
  productId          String
  product            PharmacyProduct   @relation(fields: [productId], references: [id])
  kind               StockMovementKind
  quantity           Int
  lot                String
  expiresAt          DateTime?
  at                 DateTime          @default(now())
  note               String?
  invoice            String?
  patientId          String?
  patient            Patient?          @relation(fields: [patientId], references: [id])
  prescriptionItemId String?
  prescriptionItem   PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id])
  userId             String
  user               User              @relation(fields: [userId], references: [id])

  @@index([clinicId, productId])
  @@index([prescriptionItemId])
}

// ---------- Cozinha (nutrição e dietética) ----------

enum MealKind {
  DESJEJUM
  COLACAO
  ALMOCO
  LANCHE
  JANTAR
  CEIA
}

enum MealStatus {
  ENTREGUE
  RECUSOU
  NAO_SERVIDO
}

// Refeição entregue (ou não) no leito. Não muda: se foi marcada errado, é anulada e marcada de novo.
// No banco, cada refeição do dia tem só um registro valendo por internação.
model MealDelivery {
  id           String     @id @default(cuid())
  clinicId     String
  clinic       Clinic     @relation(fields: [clinicId], references: [id])
  admissionId  String
  admission    Admission  @relation(fields: [admissionId], references: [id])
  date         DateTime   @db.Date
  meal         MealKind
  status       MealStatus
  note         String?
  at           DateTime   @default(now())
  recordedById String
  recordedBy   User       @relation("MealRecorder", fields: [recordedById], references: [id])
  canceledAt   DateTime?
  canceledById String?
  canceledBy   User?      @relation("MealCanceler", fields: [canceledById], references: [id])
  cancelReason String?

  @@index([clinicId, date])
  @@index([admissionId])
}

// ---------- CCIH (controle de infecção hospitalar) ----------

enum IsolationKind {
  CONTATO
  GOTICULAS
  AEROSSOIS
}

// Precaução de isolamento do paciente internado. Só se encerra (uma vez); nunca se apaga.
model IsolationPrecaution {
  id          String        @id @default(cuid())
  clinicId    String
  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  admissionId String
  admission   Admission     @relation(fields: [admissionId], references: [id])
  kind        IsolationKind
  // Germe ou motivo (ex.: KPC em swab retal, suspeita de tuberculose).
  reason      String
  startedAt   DateTime      @default(now())
  startedById String
  startedBy   User          @relation("IsolationStarter", fields: [startedById], references: [id])
  endedAt     DateTime?
  endedById   String?
  endedBy     User?         @relation("IsolationEnder", fields: [endedById], references: [id])
  endReason   String?

  @@index([clinicId, endedAt])
  @@index([admissionId])
}

enum InfectionSite {
  ICS
  ITU
  PAV
  ISC
  PELE
  OUTRA
}

// Infecção relacionada à assistência notificada pela CCIH. Só se anula.
model HospitalInfection {
  id           String        @id @default(cuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  admissionId  String
  admission    Admission     @relation(fields: [admissionId], references: [id])
  site         InfectionSite
  diagnosedAt  DateTime      @db.Date
  organism     String?
  // Dispositivo ligado à infecção (cateter central, sonda vesical, ventilação mecânica).
  device       String?
  note         String?
  reportedById String
  reportedBy   User          @relation("InfectionReporter", fields: [reportedById], references: [id])
  createdAt    DateTime      @default(now())
  canceledAt   DateTime?
  canceledById String?
  canceledBy   User?         @relation("InfectionCanceler", fields: [canceledById], references: [id])
  cancelReason String?

  @@index([clinicId, diagnosedAt])
  @@index([admissionId])
}

// ---------- Quimioterapia ----------

// Protocolo (ex.: AC, FOLFOX). drugs: [{ drug, dose, unit ("mg/m²" | "mg/kg" | "mg"), route, days: [1, 8] }].
model ChemoProtocol {
  id        String      @id @default(cuid())
  clinicId  String
  clinic    Clinic      @relation(fields: [clinicId], references: [id])
  name      String
  cycleDays Int
  drugs     Json
  note      String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  plans     ChemoPlan[]

  @@unique([clinicId, name])
}

// Tratamento de um paciente: protocolo, número de ciclos e a superfície corporal usada no cálculo das doses.
model ChemoPlan {
  id          String         @id @default(cuid())
  clinicId    String
  clinic      Clinic         @relation(fields: [clinicId], references: [id])
  patientId   String
  patient     Patient        @relation(fields: [patientId], references: [id])
  protocolId  String
  protocol    ChemoProtocol  @relation(fields: [protocolId], references: [id])
  physicianId String
  physician   User           @relation("ChemoPhysician", fields: [physicianId], references: [id])
  startDate   DateTime       @db.Date
  cycles      Int
  heightCm    Int
  weightKg    Float
  bsa         Float
  // Percentual da dose (100 = dose cheia; 80 = redução de 20%).
  doseLevel   Int            @default(100)
  note        String?
  createdAt   DateTime       @default(now())
  endedAt     DateTime?
  endedById   String?
  endedBy     User?          @relation("ChemoPlanEnder", fields: [endedById], references: [id])
  endReason   String?
  sessions    ChemoSession[]

  @@index([clinicId, endedAt])
}

enum ChemoSessionStatus {
  AGENDADA
  REALIZADA
  ADIADA
  CANCELADA
}

// Um dia de aplicação. As doses calculadas ficam gravadas na sessão (doses).
// O médico libera (exames ok) e a enfermagem registra a aplicação; aplicada não muda mais.
model ChemoSession {
  id               String             @id @default(cuid())
  clinicId         String
  clinic           Clinic             @relation(fields: [clinicId], references: [id])
  planId           String
  plan             ChemoPlan          @relation(fields: [planId], references: [id])
  patientId        String
  patient          Patient            @relation(fields: [patientId], references: [id])
  cycle            Int
  day              Int
  date             DateTime           @db.Date
  status           ChemoSessionStatus @default(AGENDADA)
  doses            Json
  releasedAt       DateTime?
  releasedById     String?
  releasedBy       User?              @relation("ChemoReleaser", fields: [releasedById], references: [id])
  administeredAt   DateTime?
  administeredById String?
  administeredBy   User?              @relation("ChemoAdministrator", fields: [administeredById], references: [id])
  note             String?

  @@unique([planId, cycle, day])
  @@index([clinicId, date])
}

// ---------- Centro cirúrgico ----------

model OperatingRoom {
  id        String    @id @default(cuid())
  clinicId  String
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  surgeries Surgery[]

  @@unique([clinicId, name])
}

enum SurgeryStatus {
  AGENDADA
  EM_SALA
  REALIZADA
  CANCELADA
}

enum AnesthesiaKind {
  GERAL
  RAQUI
  PERIDURAL
  SEDACAO
  BLOQUEIO
  LOCAL
}

// Cirurgia: do agendamento à saída da sala, com os tempos (entrada, anestesia, incisão, fim, saída).
model Surgery {
  id              String          @id @default(cuid())
  clinicId        String
  clinic          Clinic          @relation(fields: [clinicId], references: [id])
  patientId       String
  patient         Patient         @relation(fields: [patientId], references: [id])
  admissionId     String?
  admission       Admission?      @relation(fields: [admissionId], references: [id])
  roomId          String
  room            OperatingRoom   @relation(fields: [roomId], references: [id])
  surgeonId       String
  surgeon         User            @relation("Surgeon", fields: [surgeonId], references: [id])
  anesthetistId   String?
  anesthetist     User?           @relation("Anesthetist", fields: [anesthetistId], references: [id])
  procedure       String
  // Lado: direito, esquerdo, bilateral (ou vazio quando não se aplica).
  laterality      String?
  anesthesia      AnesthesiaKind?
  scheduledAt     DateTime
  expectedMinutes Int
  status          SurgeryStatus   @default(AGENDADA)
  note            String?
  createdById     String
  createdBy       User            @relation("SurgeryCreator", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  patientInAt     DateTime?
  anesthesiaAt    DateTime?
  incisionAt      DateTime?
  endAt           DateTime?
  patientOutAt    DateTime?
  // Descrição cirúrgica feita pelo cirurgião.
  operativeNote   String?
  canceledAt      DateTime?
  canceledById    String?
  canceledBy      User?           @relation("SurgeryCanceler", fields: [canceledById], references: [id])
  cancelReason    String?

  checklists SurgeryChecklist[]
  packages   SterilePackage[]

  @@index([clinicId, scheduledAt])
  @@index([roomId, scheduledAt])
}

enum ChecklistPhase {
  ENTRADA
  PAUSA
  SAIDA
}

// Cirurgia segura (OMS): antes da anestesia, antes da incisão e antes de sair da sala. Não muda depois de feito.
model SurgeryChecklist {
  id        String         @id @default(cuid())
  clinicId  String
  clinic    Clinic         @relation(fields: [clinicId], references: [id])
  surgeryId String
  surgery   Surgery        @relation(fields: [surgeryId], references: [id])
  phase     ChecklistPhase
  answers   Json
  note      String?
  doneById  String
  doneBy    User           @relation(fields: [doneById], references: [id])
  doneAt    DateTime       @default(now())

  @@unique([surgeryId, phase])
}

// ---------- CME (central de material e esterilização) ----------

// Caixa ou pacote de instrumentais (ex.: caixa de laparotomia) e a validade da esterilização.
model CmeKit {
  id           String           @id @default(cuid())
  clinicId     String
  clinic       Clinic           @relation(fields: [clinicId], references: [id])
  name         String
  validityDays Int              @default(30)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  packages     SterilePackage[]

  @@unique([clinicId, name])
}

enum SterilizationMethod {
  VAPOR
  PEROXIDO
  OXIDO_ETILENO
}

enum LoadResult {
  PENDENTE
  LIBERADA
  REPROVADA
  RECOLHIDA
}

// Carga (ciclo) da autoclave ou do esterilizador. Os pacotes só podem ser usados depois de liberada.
model SterilizationLoad {
  id           String              @id @default(cuid())
  clinicId     String
  clinic       Clinic              @relation(fields: [clinicId], references: [id])
  code         String
  method       SterilizationMethod
  equipment    String
  startedAt    DateTime            @default(now())
  operatorId   String
  operator     User                @relation("LoadOperator", fields: [operatorId], references: [id])
  result       LoadResult          @default(PENDENTE)
  chemicalOk   Boolean?
  biologicalOk Boolean?
  resultAt     DateTime?
  resultById   String?
  resultBy     User?               @relation("LoadJudge", fields: [resultById], references: [id])
  resultNote   String?
  packages     SterilePackage[]

  @@unique([clinicId, code])
}

// Pacote esterilizado: de qual carga, até quando vale e em qual cirurgia foi usado (rastreabilidade).
model SterilePackage {
  id            String            @id @default(cuid())
  clinicId      String
  clinic        Clinic            @relation(fields: [clinicId], references: [id])
  loadId        String
  load          SterilizationLoad @relation(fields: [loadId], references: [id])
  kitId         String
  kit           CmeKit            @relation(fields: [kitId], references: [id])
  expiresAt     DateTime
  surgeryId     String?
  surgery       Surgery?          @relation(fields: [surgeryId], references: [id])
  usedAt        DateTime?
  usedById      String?
  usedBy        User?             @relation("PackageUser", fields: [usedById], references: [id])
  discardedAt   DateTime?
  discardedById String?
  discardedBy   User?             @relation("PackageDiscarder", fields: [discardedById], references: [id])
  discardReason String?

  @@index([clinicId, kitId])
  @@index([loadId])
  @@index([surgeryId])
}

// ---------- Laboratório e imagem ----------

enum ExamSector {
  LABORATORIO
  IMAGEM
}

enum ExamPriority {
  ROTINA
  URGENTE
}

enum ExamStatus {
  SOLICITADO
  AGENDADO
  COLETADO
  LAUDADO
  CANCELADO
}

// Exame do catálogo. Laboratório: campos do resultado com unidade e referência (fields: [{ name, unit, min, max }]).
// Imagem: modalidade (raio X, tomografia...) e laudo em texto.
model ExamType {
  id          String        @id @default(cuid())
  clinicId    String
  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  sector      ExamSector
  name        String
  modality    String?
  sample      String?
  preparation String?
  fields      Json          @default("[]")
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  requests    ExamRequest[]

  @@unique([clinicId, name])
}

// Pedido de exame: do médico do hospital (internação ou PS) ou de médico de fora (recepção agenda).
// Coletado (laboratório) ou realizado (imagem), depois laudado. Laudado ou cancelado não muda mais.
model ExamRequest {
  id                String          @id @default(cuid())
  clinicId          String
  clinic            Clinic          @relation(fields: [clinicId], references: [id])
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id])
  examTypeId        String
  examType          ExamType        @relation(fields: [examTypeId], references: [id])
  admissionId       String?
  admission         Admission?      @relation(fields: [admissionId], references: [id])
  emergencyVisitId  String?
  emergencyVisit    EmergencyVisit? @relation(fields: [emergencyVisitId], references: [id])
  requestedById     String?
  requestedBy       User?           @relation("ExamRequester", fields: [requestedById], references: [id])
  // Médico de fora (nome e CRM), quando o pedido vem de outro serviço.
  externalRequester String?
  createdById       String
  createdBy         User            @relation("ExamCreator", fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())
  priority          ExamPriority    @default(ROTINA)
  clinicalInfo      String?
  status            ExamStatus      @default(SOLICITADO)
  scheduledAt       DateTime?
  collectedAt       DateTime?
  collectedById     String?
  collectedBy       User?           @relation("ExamCollector", fields: [collectedById], references: [id])
  resultAt          DateTime?
  resultById        String?
  resultBy          User?           @relation("ExamReporter", fields: [resultById], references: [id])
  values            Json?
  report            String?
  // Valor crítico: a quem foi comunicado e quando.
  criticalNote      String?
  canceledAt        DateTime?
  canceledById      String?
  canceledBy        User?           @relation("ExamCanceler", fields: [canceledById], references: [id])
  cancelReason      String?

  @@index([clinicId, status])
  @@index([clinicId, scheduledAt])
  @@index([admissionId])
  @@index([emergencyVisitId])
  @@index([patientId])
}

// ---------- Almoxarifado ----------

// Material que não é da farmácia: limpeza, escritório, rouparia, manutenção, descartáveis.
model SupplyItem {
  id        String              @id @default(cuid())
  clinicId  String
  clinic    Clinic              @relation(fields: [clinicId], references: [id])
  name      String
  category  String
  unit      String              @default("unidade")
  minStock  Int                 @default(0)
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  movements SupplyMovement[]
  lines     SupplyRequestLine[]

  @@unique([clinicId, name])
}

enum SupplyMovementKind {
  ENTRADA
  SAIDA
  AJUSTE
  PERDA
}

// Entrada, saída para um setor, ajuste ou perda. Não muda nem some: o saldo é a soma.
model SupplyMovement {
  id        String             @id @default(cuid())
  clinicId  String
  clinic    Clinic             @relation(fields: [clinicId], references: [id])
  itemId    String
  item      SupplyItem         @relation(fields: [itemId], references: [id])
  kind      SupplyMovementKind
  quantity  Int
  sector    String?
  invoice   String?
  note      String?
  requestId String?
  request   SupplyRequest?     @relation(fields: [requestId], references: [id])
  at        DateTime           @default(now())
  userId    String
  user      User               @relation(fields: [userId], references: [id])

  @@index([clinicId, itemId])
  @@index([requestId])
}

enum SupplyRequestStatus {
  ABERTA
  ATENDIDA
  CANCELADA
}

// Pedido de material feito por um setor ao almoxarifado.
model SupplyRequest {
  id            String              @id @default(cuid())
  clinicId      String
  clinic        Clinic              @relation(fields: [clinicId], references: [id])
  sector        String
  note          String?
  status        SupplyRequestStatus @default(ABERTA)
  createdAt     DateTime            @default(now())
  requestedById String
  requestedBy   User                @relation("SupplyRequester", fields: [requestedById], references: [id])
  handledAt     DateTime?
  handledById   String?
  handledBy     User?               @relation("SupplyHandler", fields: [handledById], references: [id])
  handledNote   String?
  lines         SupplyRequestLine[]
  movements     SupplyMovement[]

  @@index([clinicId, status])
}

model SupplyRequestLine {
  id        String        @id @default(cuid())
  clinicId  String
  clinic    Clinic        @relation(fields: [clinicId], references: [id])
  requestId String
  request   SupplyRequest @relation(fields: [requestId], references: [id])
  itemId    String
  item      SupplyItem    @relation(fields: [itemId], references: [id])
  quantity  Int
  delivered Int?

  @@unique([requestId, itemId])
}

// ---------- Manutenção e infraestrutura ----------

// Equipamento com patrimônio. A preventiva vence a cada preventiveDays dias, contando da última.
model Equipment {
  id               String      @id @default(cuid())
  clinicId         String
  clinic           Clinic      @relation(fields: [clinicId], references: [id])
  name             String
  tag              String
  location         String
  brandModel       String?
  serial           String?
  preventiveDays   Int?
  lastPreventiveAt DateTime?
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  workOrders       WorkOrder[]

  @@unique([clinicId, tag])
}

enum WorkOrderKind {
  CORRETIVA
  PREVENTIVA
}

enum WorkOrderStatus {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

// Chamado de manutenção: equipamento, elétrica, hidráulica, gases medicinais, climatização...
// Concluído ou cancelado não muda mais.
model WorkOrder {
  id          String          @id @default(cuid())
  clinicId    String
  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  number      Int
  kind        WorkOrderKind   @default(CORRETIVA)
  category    String
  location    String
  equipmentId String?
  equipment   Equipment?      @relation(fields: [equipmentId], references: [id])
  description String
  urgent      Boolean         @default(false)
  stopped     Boolean         @default(false)
  status      WorkOrderStatus @default(ABERTO)
  assignedTo  String?
  createdAt   DateTime        @default(now())
  openedById  String
  openedBy    User            @relation("WorkOrderOpener", fields: [openedById], references: [id])
  startedAt   DateTime?
  closedAt    DateTime?
  closedById  String?
  closedBy    User?           @relation("WorkOrderCloser", fields: [closedById], references: [id])
  solution    String?

  @@unique([clinicId, number])
  @@index([clinicId, status])
  @@index([equipmentId])
}

// ---------- Conta hospitalar ----------

// Tabela de preços própria do hospital. key: "diaria:<tipo da ala>", "exame:<id do exame>",
// "med:<id do produto da farmácia>" ou "sala:hora" (taxa de sala cirúrgica por hora).
model HospitalPrice {
  id         String   @id @default(cuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id])
  key        String
  priceCents Int
  updatedAt  DateTime @updatedAt

  @@unique([clinicId, key])
}

enum BillStatus {
  ABERTA
  FECHADA
}

enum BillItemKind {
  DIARIA
  MEDICAMENTO
  EXAME
  CIRURGIA
  TAXA
  OUTRO
}

// Conta de uma internação: diárias, medicamentos dispensados, exames, cirurgias e lançamentos à mão.
// Fecha depois da alta e não muda mais; a particular vira uma cobrança no Financeiro.
model HospitalBill {
  id          String             @id @default(cuid())
  clinicId    String
  clinic      Clinic             @relation(fields: [clinicId], references: [id])
  admissionId String             @unique
  admission   Admission          @relation(fields: [admissionId], references: [id])
  payer       String
  status      BillStatus         @default(ABERTA)
  totalCents  Int                @default(0)
  createdAt   DateTime           @default(now())
  closedAt    DateTime?
  closedById  String?
  closedBy    User?              @relation(fields: [closedById], references: [id])
  chargeId    String?            @unique
  charge      Charge?            @relation(fields: [chargeId], references: [id])
  items       HospitalBillItem[]

  @@index([clinicId, status])
}

// Linha da conta. source: de onde veio o lançamento automático (ex.: "exame:<id>"); nulo = lançado à mão.
model HospitalBillItem {
  id          String       @id @default(cuid())
  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  billId      String
  bill        HospitalBill @relation(fields: [billId], references: [id])
  kind        BillItemKind
  source      String?
  description String
  quantity    Int
  unitCents   Int
  totalCents  Int
  at          DateTime     @default(now())
  addedById   String?
  addedBy     User?        @relation(fields: [addedById], references: [id])

  @@unique([billId, source])
  @@index([billId])
}

// ---- Especialidades no hospital: parecer e transferência ----

enum ConsultStatus {
  PENDENTE
  RESPONDIDO
  CANCELADO
}

// Pedido de parecer (interconsulta): a equipe que cuida do internado pede a opinião de outra especialidade.
// Responde qualquer médico da especialidade pedida (ou o médico escolhido). Respondido não muda mais.
model ConsultRequest {
  id            String        @id @default(cuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id])
  admissionId   String
  admission     Admission     @relation(fields: [admissionId], references: [id])
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id])
  // Especialidade pedida (mesmo texto da especialidade do cadastro do médico).
  specialty     String
  // Médico específico (opcional); vazio = qualquer um da especialidade.
  consultantId  String?
  consultant    User?         @relation("ConsultConsultant", fields: [consultantId], references: [id])
  urgent        Boolean       @default(false)
  question      String
  requestedById String
  requestedBy   User          @relation("ConsultRequester", fields: [requestedById], references: [id])
  createdAt     DateTime      @default(now())
  status        ConsultStatus @default(PENDENTE)
  answer        String?
  answeredById  String?
  answeredBy    User?         @relation("ConsultAnswerer", fields: [answeredById], references: [id])
  answeredAt    DateTime?
  // A especialidade do parecer assumiu o paciente ao responder.
  tookOver      Boolean       @default(false)
  canceledAt    DateTime?
  canceledById  String?
  canceledBy    User?         @relation("ConsultCanceler", fields: [canceledById], references: [id])
  cancelReason  String?

  @@index([clinicId, status, specialty])
  @@index([admissionId])
}

// Troca do médico responsável (e da especialidade) de uma internação: "a clínica médica passa o paciente para a cirurgia".
model AttendingChange {
  id              String    @id @default(cuid())
  clinicId        String
  clinic          Clinic    @relation(fields: [clinicId], references: [id])
  admissionId     String
  admission       Admission @relation(fields: [admissionId], references: [id])
  fromAttendingId String
  fromAttending   User      @relation("AttendingChangeFrom", fields: [fromAttendingId], references: [id])
  toAttendingId   String
  toAttending     User      @relation("AttendingChangeTo", fields: [toAttendingId], references: [id])
  fromSpecialty   String?
  toSpecialty     String?
  reason          String?
  // Pelo parecer respondido com "assumir o paciente".
  consultId       String?
  changedById     String
  changedBy       User      @relation("AttendingChangeBy", fields: [changedById], references: [id])
  changedAt       DateTime  @default(now())

  @@index([admissionId])
}
